# --- Servidor ---
PORT=3030
NODE_ENV=development
LOG_LEVEL=info

# --- Base de datos ---
# Local (docker compose): postgres://lattente:lattente@localhost:5433/lattente
# Producción (CapRover): el Postgres compartido del cluster, por su nombre de
# red interno de Docker Swarm:
#   postgresql://lattente:<password>@srv-captain--postgresql:5432/lattente
# Desde fuera del cluster (solo para administración), el host público es
# <ip-del-vps>:5432 y la DB se crea a mano:
#   CREATE ROLE lattente LOGIN PASSWORD '<password>';
#   CREATE DATABASE lattente OWNER lattente;
DATABASE_URL=postgresql://lattente:lattente@localhost:5433/lattente

# Espera a que la base de datos esté lista al arrancar (CapRover).
DB_WAIT_ATTEMPTS=30
DB_WAIT_DELAY_MS=2000

# --- Admin / CMS ---
# ¡CAMBIAR antes de desplegar! La contraseña de /admin.
ADMIN_PASSWORD=lattente-admin
# Secreto para firmar los JWT. Generar con: openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h

# --- Rate limiting ---
LOGIN_RATE_LIMIT=20
API_RATE_LIMIT=120

# --- Proxy (CapRover) ---
# CapRover termina TLS en nginx y manda la IP real en X-Forwarded-For.
# 1 = confiar en un salto (nginx). NO poner `true`: permitiría a un cliente
# suplantar su IP y evadir el rate limit.
TRUST_PROXY=1
# --- Uploads ---
# Directorio donde se guardan las fotos subidas. En producción debe ser un
# volumen persistente de CapRover (p.ej. /app/data/uploads) para que no se
# pierdan al redesplegar. Vacío = guardar dentro de public/uploads.
UPLOAD_DIR=
