{
  "name": "lattente",
  "version": "1.0.0",
  "description": "Sitio web Lattente — café, desayunos y pedidos",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "db:init": "node server/db/init.js",
    "db:migrate": "node server/db/migrate.js",
    "docker:build": "docker build -t lattente:local .",
    "docker:run": "docker run --rm -p 3030:3030 --env-file .env lattente:local"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "pg": "^8.13.3",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  }
}
